{
  "expo": {
    "name": "Gastos de Viagem",
    "slug": "gastos-de-viagem",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F0ECE7"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.suaempresa.gastosdeviagem"
    },
    "android": {
      "package": "com.suaempresa.gastosdeviagem",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#F0ECE7"
      }
    },
    "plugins": [
      "expo-asset",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "24e324bd-028b-481a-bfa3-a56c4c115b05"
      }
    }
  }
}